//go:build windows

package main

import (
	"os/exec"
	"syscall"
)

// prepareHiddenCmd prevents child processes (cmd, powershell, temporary exes, etc.) from spawning a console window.
func prepareHiddenCmd(cmd *exec.Cmd) {
	if cmd == nil {
		return
	}
	// Use HideWindow only: equivalent to CREATE_NO_WINDOW, and syscall.CREATE_NO_WINDOW
	// is unavailable when cross-compiling Windows binaries from macOS/Linux.
	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
}
